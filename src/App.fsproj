    <Compile Include="Pages/Search.fs" />
    <Compile Include="Pages/WitnessesContent.fs" />
    <Compile Include="Pages/Witnesses.fs" />
    <Compile Include="Pages/TimelineContent.fs" />
    <Compile Include="Pages/Timeline.fs" />
    <Compile Include="Pages/PhotobookContent.fs" />
